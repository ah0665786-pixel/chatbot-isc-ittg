# ============ LLM (hasta 3 proveedores en cadena de respaldo) ============
# Todos hablan el protocolo "OpenAI-compatible" (/chat/completions y /models).
# Si el 1 falla o su modelo se retira, el sistema usa el 2, luego el 3.
# Verifica los IDs vigentes con:  python -m app.cli check-llm

# 1) Principal (ejemplo: Groq, gratis sin tarjeta)
# OJO: el plan gratis limita a ~3 consultas/minuto por el tope de tokens.
# Para producción real (20+ consultas concurrentes) usar el plan Developer
# de Groq (pago por uso, sin suscripción) — ver docs/capacidad-y-costos.md
LLM_1_NAME=groq
LLM_1_BASE_URL=https://api.groq.com/openai/v1
LLM_1_API_KEY=
LLM_1_MODEL=openai/gpt-oss-120b
# gpt-oss es un modelo "razonador": sin esto puede devolver respuesta vacía
LLM_1_EXTRA={"reasoning_effort":"low"}

# 2) Respaldo (ejemplo: OpenAI, de pago pero barato)
LLM_2_NAME=openai
LLM_2_BASE_URL=https://api.openai.com/v1
LLM_2_API_KEY=
LLM_2_MODEL=gpt-4o-mini

# 3) Respaldo local (Ollama: nadie lo puede dar de baja)
LLM_3_NAME=ollama
LLM_3_BASE_URL=http://localhost:11434/v1
LLM_3_API_KEY=ollama
LLM_3_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.3
LLM_TIMEOUT=25
LLM_MAX_RETRIES=3
LLM_TOTAL_BUDGET=80

# ============ Embeddings (locales, sin API, sin costo) ============
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_QUERY_PREFIX=query: 
EMBED_DOC_PREFIX=passage: 

# ============ RAG (se calibran con: python -m app.cli calibrate data/retrieval_cases.jsonl) ============
# Ojo: el umbral "equilibrado" que sugiere calibrate sale inflado si el conjunto tiene
# muchas preguntas de un solo tema; 0.80 deja margen bajo la pregunta válida más baja (0.844).
CHUNK_WORDS=180
CHUNK_OVERLAP_WORDS=30
TOP_K=5
SIM_THRESHOLD=0.80
GROUNDING_MIN=0.45

# ============ Contacto para derivaciones ============
# Lo que el estudiante lee cuando el chatbot lo manda a la Coordinación (RF-C-04, HU-08)
CONTACT_EMAIL=csistemas@tuxtla.tecnm.mx
CONTACT_HOURS=lunes a viernes de 8:00 a 15:00 horas

# ============ Avisos por correo a la coordinadora (HU-11) ============
# Cuando el chatbot deriva una consulta, prepara un aviso con la pregunta y el
# motivo. Cada aviso queda registrado en la tabla "avisos" y en el log.
#   vista_previa  (recomendado al empezar) NO envía nada: guarda cada aviso como
#                 archivo .eml en AVISOS_CARPETA para revisarlo (se abre con Outlook,
#                 Thunderbird o el Bloc de notas).
#   prueba        envía de verdad, pero SOLO a AVISOS_CORREO_PRUEBA (tu correo).
#                 Si AVISOS_CORREO_PRUEBA está vacío, no envía: lo guarda en la carpeta.
#   coordinadora  envía a COORDINADORA_EMAIL. Ponlo solo cuando ya hayas revisado
#                 los avisos en vista previa y en prueba.
#   desactivado   no prepara avisos.
AVISOS_MODO=vista_previa
AVISOS_CORREO_PRUEBA=
AVISOS_CARPETA=data/outbox
COORDINADORA_EMAIL=csistemas@tuxtla.tecnm.mx

# Tipos de aviso (según por qué se derivó la consulta):
#   datos_personales  pidió datos personales o un trámite oficial (kárdex, constancias)
#   sin_informacion   los documentos no responden la pregunta
#   falla_tecnica     el servicio de IA no respondió
# AVISOS_INMEDIATOS: tipos que se avisan al momento, separados por comas. Los demás
# van al resumen diario. Por defecto solo falla_tecnica: es lo único que la
# coordinación tiene que atender en el momento (el chatbot no está respondiendo).
AVISOS_INMEDIATOS=falla_tecnica
# AVISOS_RESUMEN_HORA: a esta hora (HH:MM, hora de Tuxtla) llega un resumen con
# las consultas derivadas del DÍA ANTERIOR (00:00 a 24:00) y el conteo por tipo.
# 08:00 = al empezar el horario de atención, con el día anterior completo. Si un
# día no hubo derivaciones, no se manda nada. Vacío = sin resumen: todos los tipos
# se avisan al momento. Ver ejemplos de cada correo con:
#   python -m app.cli ejemplos-avisos
AVISOS_RESUMEN_HORA=08:00
# AVISOS_FALLA_INTERVALO_MIN: si el servicio de IA se cae, cada consulta se deriva
# por "falla técnica". Para no llenar el buzón, llega como máximo un aviso cada
# tantos minutos; el siguiente dice cuántas consultas se afectaron en ese lapso.
# Se cuenta desde la base de datos, así que funciona aunque el bot se reinicie.
# 0 = un aviso por cada consulta.
AVISOS_FALLA_INTERVALO_MIN=30

# Servidor de correo. Con Gmail: smtp.gmail.com, puerto 587 y STARTTLS.
# SMTP_PASSWORD es una "contraseña de aplicación" de 16 letras (Cuenta de Google >
# Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones), NO la
# contraseña normal de la cuenta. El sistema nunca la escribe en el log ni en los avisos.
# Para probar el envío (manda UN aviso a AVISOS_CORREO_PRUEBA, nunca a la coordinadora):
#   python -m app.cli probar-correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
# Cuenta que envía los avisos; también es el remitente ("From"), como exige Gmail
SMTP_USER=tellbotittg@gmail.com
SMTP_PASSWORD=

# ============ Bot de Telegram ============
# Se obtiene hablando con @BotFather en Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# ============ Panel de administración (coordinadora) ============
ADMIN_USER=coordinadora
ADMIN_PASSWORD=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000

# ============ Reportes del panel (HU-13, HU-15) ============
# Consultas mínimas en un periodo para que sus cifras sean confiables. Con menos,
# el panel avisa "datos insuficientes" y dice desde qué día habría que tomar el
# periodo. 20 es lo mínimo para que el p95 (tiempo en que se responde el 95 % de
# las consultas) no sea simplemente la consulta más lenta. Subirlo (p. ej. 50)
# da tasas más estables, pero pide periodos más largos.
REPORTES_MIN_CONSULTAS=20

# ============ Base de datos ============
# Vacío = SQLite (data/app.db). Con valor = PostgreSQL. Bot y panel usan la misma.
# En Docker no hace falta: docker-compose.yml la arma apuntando al servicio "db".
DATABASE_URL=

# Credenciales del PostgreSQL de docker-compose.yml (POSTGRES_PASSWORD es obligatoria)
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot_isc
