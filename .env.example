# ============ LLM (hasta 3 proveedores en cadena de respaldo) ============
# Todos hablan el protocolo "OpenAI-compatible" (/chat/completions y /models).
# Si el 1 falla o su modelo se retira, el sistema usa el 2, luego el 3.
# Verifica los IDs vigentes con:  python -m app.cli check-llm

# 1) Principal (ejemplo: Groq, gratis sin tarjeta)
# OJO: el plan gratis limita a ~3 consultas/minuto por el tope de tokens.
# Para producción real (20+ consultas concurrentes) usar el plan Developer
# de Groq (pago por uso, sin suscripción) — ver docs/capacidad-y-costos.md
LLM_1_NAME=groq
LLM_1_BASE_URL=https://api.groq.com/openai/v1
LLM_1_API_KEY=
LLM_1_MODEL=openai/gpt-oss-120b
# gpt-oss es un modelo "razonador": sin esto puede devolver respuesta vacía
LLM_1_EXTRA={"reasoning_effort":"low"}

# 2) Respaldo (ejemplo: OpenAI, de pago pero barato)
LLM_2_NAME=openai
LLM_2_BASE_URL=https://api.openai.com/v1
LLM_2_API_KEY=
LLM_2_MODEL=gpt-4o-mini

# 3) Respaldo local (Ollama: nadie lo puede dar de baja)
LLM_3_NAME=ollama
LLM_3_BASE_URL=http://localhost:11434/v1
LLM_3_API_KEY=ollama
LLM_3_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.3
LLM_TIMEOUT=25
LLM_MAX_RETRIES=3
LLM_TOTAL_BUDGET=80

# ============ Embeddings (locales, sin API, sin costo) ============
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_QUERY_PREFIX=query: 
EMBED_DOC_PREFIX=passage: 

# ============ RAG (se calibran con: python -m app.cli calibrate) ============
CHUNK_WORDS=180
CHUNK_OVERLAP_WORDS=30
TOP_K=5
SIM_THRESHOLD=0.75
GROUNDING_MIN=0.45

# ============ Contacto para derivaciones ============
CONTACT_EMAIL=
CONTACT_HOURS=lunes a viernes de 8:00 a 15:00 horas

# ============ Bot de Telegram ============
# Se obtiene hablando con @BotFather en Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# ============ Panel de administración (coordinadora) ============
ADMIN_USER=coordinadora
ADMIN_PASSWORD=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000

# ============ Base de datos ============
# Vacío = SQLite (data/app.db). Con valor = PostgreSQL. Bot y panel usan la misma.
# En Docker no hace falta: docker-compose.yml la arma apuntando al servicio "db".
DATABASE_URL=

# Credenciales del PostgreSQL de docker-compose.yml (POSTGRES_PASSWORD es obligatoria)
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot_isc
